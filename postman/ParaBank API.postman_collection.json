        {
          "name": "Login (john/demo - default seeded user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "pm.test(\"Response contains customer id\", function () {",
                  "    pm.expect(match).to.not.be.null;",
                  "});",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"customerId\", match[1]);",
                  "    console.log(\"Captured customerId:\", match[1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
